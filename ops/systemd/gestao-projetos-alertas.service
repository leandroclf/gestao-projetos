[Unit]
Description=Alertas e relatório gerencial visual da equipe de Integrações

[Service]
Type=oneshot
WorkingDirectory=/home/leandro/IdeaProjects/lfsolucoes/gestao-projetos
Environment=PYTHONPATH=src
ExecStart=/usr/bin/flock -n /tmp/gestao-projetos-alertas.lock /bin/sh -c '/usr/bin/python3 -m notion_management notify --send --schedule && /usr/bin/python3 -m notion_management report --send'
